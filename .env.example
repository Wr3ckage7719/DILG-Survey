# ─── Survey submission ───
# Google Apps Script web app URL (server-side only — never expose in the client).
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─── Admin dashboard (Vercel environment variables) ───
# Shared secret that HMAC-signs admin session tokens and gates the Apps Script
# admin API. MUST match the Apps Script script property ADMIN_API_SECRET.
# Set the same value in local .env for the Vite dev proxy (dev traffic only).
ADMIN_GS_SECRET=change-me-to-a-long-random-string

# (Optional) First-line login password enforced by the Vercel function. The
# Apps Script script property ADMIN_PASSWORD remains authoritative — set both.
ADMIN_PASSWORD=change-me

# ─── Apps Script script properties (Extensions → Properties → Script properties) ───
# ADMIN_API_SECRET — same value as ADMIN_GS_SECRET above
# ADMIN_PASSWORD   — the admin dashboard password
# TEMPLATE_DOC_ID        / TEMPLATE_DOC_ID_EN — printable doc templates
# OUTPUT_FOLDER_ID       — where generated printable docs are saved
# WEBAPP_URL             — the live web app URL (used by the keep-warm trigger)
